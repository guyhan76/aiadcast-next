{
  "name": "aiadcast-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:domain": "node --experimental-strip-types --test tests-domain/*.test.mjs",
    "check:cloud": "node scripts/build-cloud-variants.mjs --check",
    "check:isolation": "node scripts/check-isolation.mjs",
    "release:status": "node scripts/release-status.mjs",
    "release:package": "python3 scripts/package-release.py",
    "pricing:report": "node --experimental-strip-types scripts/pricing-report.mjs",
    "models:discover": "node scripts/discover-models.mjs",
    "api:dev": "node --use-env-proxy server/generation-server.mjs",
    "api:beta": "bash scripts/run-beta.sh",
    "prebuild": "node scripts/build-lookbook-font.mjs",
    "predev": "node scripts/build-lookbook-font.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource-variable/noto-serif-kr": "5.3.0",
    "lucide-react": "1.52.0",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "typescript-compiler": "npm:typescript@5.9.3",
    "vite": "8.3.3"
  }
}
